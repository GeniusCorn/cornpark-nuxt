{
  "name": "cornpark-nuxt",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "nuxt build",
    "coverage": "vitest --coverage",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "postinstall": "nuxt prepare",
    "preview": "nuxt preview",
    "test": "vitest",
    "auth:generate": "pnpm dlx @better-auth/cli generate --config ./shared/auth.ts --output ./server/db/schema.ts",
    "auth:push": "pnpm exec drizzle-kit push --config ./server/db/drizzle.config.ts"
  },
  "dependencies": {
    "@libsql/client": "catalog:server",
    "@nuxt/content": "catalog:frontend",
    "@nuxtjs/color-mode": "catalog:frontend",
    "better-auth": "catalog:shared",
    "better-sqlite3": "catalog:server",
    "dayjs-nuxt": "catalog:frontend",
    "drizzle-orm": "catalog:server",
    "nuxt": "catalog:frontend",
    "vue": "catalog:frontend",
    "vue-router": "catalog:frontend"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:dev",
    "@iconify/json": "catalog:dev",
    "@nuxt/test-utils": "catalog:dev",
    "@types/better-sqlite3": "catalog:types",
    "@unocss/eslint-plugin": "catalog:dev",
    "@unocss/nuxt": "catalog:dev",
    "@vitest/coverage-v8": "catalog:dev",
    "@vitest/ui": "catalog:dev",
    "@vue/test-utils": "catalog:dev",
    "@vueuse/core": "catalog:dev",
    "@vueuse/nuxt": "catalog:dev",
    "@vueuse/router": "catalog:dev",
    "drizzle-kit": "catalog:server",
    "eslint": "catalog:dev",
    "eslint-plugin-format": "catalog:dev",
    "happy-dom": "catalog:dev",
    "lint-staged": "catalog:dev",
    "playwright-core": "catalog:dev",
    "simple-git-hooks": "catalog:dev",
    "tsx": "catalog:build",
    "unocss": "catalog:build",
    "vitest": "catalog:dev"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
